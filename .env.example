# ==============================================================================
# Pumpkin Minecraft Server Environment Configuration (.env)
# ==============================================================================
# Note: Variables defined here override settings in docker-compose.yml.
# Uncomment and customize any options below:
# ==============================================================================

# Target Minecraft Version (e.g. 26.2, 26.3, nightly)
# VERSION=26.2

# Maximum concurrent players
# MAX_PLAYERS=10

# View / Render distance (default 32 chunks)
# VIEW_DISTANCE=32

# Simulation distance
# SIMULATION_DISTANCE=16

# World generation seed (leave empty for random / existing)
# SEED=

# Broadcast to LAN Minecraft server list
# LAN_BROADCAST=true

# Game mode (Survival, Creative, Adventure, Spectator)
# GAMEMODE=Survival

# Difficulty (Peaceful, Easy, Normal, Hard)
# DIFFICULTY=Normal

# Server MOTD
# MOTD=A blazingly fast Pumpkin Minecraft server!

# Online mode (false allows offline/LAN accounts)
# ONLINE_MODE=false

# Default operator permission level (4 = Owner/Admin)
# DEFAULT_OP_LEVEL=4

# Primary operator account(s) to auto-initialize in ops.json (comma-separated supported)
# OP_ACCOUNT=MuQarica

# Server icon (64x64 PNG in /data)
# SERVER_ICON=server.png

# Check for updates on GitHub before starting
# AUTO_UPDATE=true

# Container RAM limit and reservation (e.g. 2g, 4g, 6g, 8g)
# RAM_LIMIT=6g
# RAM_RESERVATION=1g
